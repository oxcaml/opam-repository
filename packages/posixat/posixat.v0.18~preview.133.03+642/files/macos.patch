--- a/src/common.h
+++ b/src/common.h
@@ -32,6 +32,22 @@
 #include <errno.h>
 #endif
 
+#if defined(__APPLE__)
+/* renameat2 via renameatx_np; RENAME_WHITEOUT is unsupported (EINVAL) */
+#define SHEXP_RENAME_UNSUPPORTED 0x40000000
+
+static inline int renameat2(int olddir, const char *oldpath,
+                            int newdir, const char *newpath,
+                            unsigned int flags)
+{
+  if (flags & SHEXP_RENAME_UNSUPPORTED) {
+    errno = EINVAL;
+    return -1;
+  }
+  return renameatx_np(olddir, oldpath, newdir, newpath, flags);
+}
+#endif
+
 extern int shexp_at_flag_table[];
 extern int shexp_rename_flag_table[];
 extern int shexp_open_flag_table[];
