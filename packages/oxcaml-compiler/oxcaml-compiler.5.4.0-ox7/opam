depends: [
  "conf-autoconf"         {build}
  "conf-which"            {build}
  "ocaml-variants"        {= "5.4.0+ox" & post}
  "oxcaml"                {post}
  "base-unix"             {post}
  "base-bigarray"         {post}
  "base-threads"          {post}
  "base-domains"          {post}
  "base-nnp"              {post}
  "ocaml-options-vanilla" {post}
  "oxcaml-patch-guards"   {post}
]
setenv: CAML_LD_LIBRARY_PATH = "%{lib}%/stublibs"
build: [
  ["sh" "-c" "echo '(dirs (:standard \\ init_deps dune-3.23.1 menhir-20231231-d3d815e4f554da68b8c247241c8f8678926eecaa ocaml-5.4.0))' >> dune"]
  ["tar" "-xf" "init-compiler.tar.gz"]
  ["tar" "-xf" "init-dune.tbz"]
  ["tar" "-xf" "init-menhir.tar.gz"]
  [
    "sh"
    "-exc"
    "cd ocaml-5.4.0 && ./configure --prefix %{build}%/init_deps --disable-ocamldoc"
  ] {os != "openbsd" & os != "macos"}
  [
    "sh"
    "-exc"
    "cd ocaml-5.4.0 && ./configure --prefix %{build}%/init_deps --disable-ocamldoc CC=cc ASPP='cc -c'"
  ] {os = "openbsd" | os = "macos"}
  ["sh" "-exc" "make -C ocaml-5.4.0 -j%{jobs}%"]
  ["sh" "-exc" "make -C ocaml-5.4.0 install"]
  [
    "sh"
    "-exc"
    "cd dune-3.23.1; PATH=%{build}%/init_deps/bin/:$PATH ocaml boot/bootstrap.ml -j %{jobs}%"
  ]
  [
    "sh"
    "-exc"
    "cd dune-3.23.1; PATH=%{build}%/init_deps/bin/:$PATH ./_boot/dune.exe build dune.install --release --profile dune-bootstrap -j %{jobs}%"
  ]
  [
    "sh"
    "-exc"
    "cd dune-3.23.1; PATH=%{build}%/init_deps/bin/:$PATH ./_boot/dune.exe install --root %{build}%/dune-3.23.1 --prefix %{build}%/init_deps/ dune"
  ]
  [
    "sh"
    "-exc"
    "cd menhir-20231231-d3d815e4f554da68b8c247241c8f8678926eecaa; PATH=%{build}%/init_deps/bin/:$PATH %{build}%/init_deps/bin/dune build --profile release --root %{build}%/menhir-20231231-d3d815e4f554da68b8c247241c8f8678926eecaa @install -j %{jobs}%"
  ]
  [
    "sh"
    "-exc"
    "cd menhir-20231231-d3d815e4f554da68b8c247241c8f8678926eecaa; PATH=%{build}%/init_deps/bin/:$PATH %{build}%/init_deps/bin/dune install --prefix %{build}%/init_deps/ -p menhirLib,menhir -j %{jobs}%"
  ]
  ["sh" "-exc" "autoconf || autoconf27"]
  [
    "sh"
    "-exc"
    "PATH=%{build}%/init_deps/bin/:$PATH ./configure --enable-middle-end=flambda2 --enable-runtime5 --enable-stack-checks --enable-poll-insertion --enable-multidomain --disable-warn-error '--prefix=%{prefix}%' '--with-dune=%{build}%/init_deps/bin/dune'"
  ]
  [
    "sh"
    "-exc"
    "unset INSIDE_DUNE; PATH=%{build}%/init_deps/bin/:$PATH make -j%{jobs}%"
  ]
  ["sh" "./write-config.sh" name "-v" "release:string" "5.4.0-ox7" "-v" "commit:string" "16927fa9eaa8f8b7e09263ac99019f25f89817a1"]
]
install: ["sh" "-exc" "PATH=%{build}%/init_deps/bin/:$PATH make install"]
