+static void extern_grow_objs(struct caml_extern_state *s)
+{
+  mlsize_t new_capacity = 2 * s->pos_table.capacity;
+  mlsize_t new_byte_size;
+  value * new_objs;
+
+  /* Slots are 32 bits wide */
+  if (new_capacity > (mlsize_t) 1 << 32
+      || caml_umul_overflow(new_capacity, sizeof(value), &new_byte_size))
+    extern_failwith(s, "output_value: too many objects");
+  if (s->pos_table.objs == s->pos_table_objs_init) {
+    new_objs = caml_stat_alloc_noexc(new_byte_size);
+    if (new_objs == NULL) extern_out_of_memory(s);
