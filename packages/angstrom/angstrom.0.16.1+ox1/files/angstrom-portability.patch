+[%%template
+[@@@mode.default (p, c) = ((portable, contended), (nonportable, uncontended))]
+[@@@kind k = value mod c]
+
+module type Choice = sig
+  type 'a t
+
+  (** [p <|> q] runs [p] and returns the result if succeeds. If [p] fails, then
+      the input will be reset and [q] will run instead. *)
+  val ( <|> ) : 'a t @ p -> 'a t @ p -> 'a t @ p
+
+  (** [p <?> name] associates [name] with the parser [p], which will be reported
+      in the case of failure. *)
+  val ( <?> ) : 'a t @ p -> string -> 'a t @ p
+end
+
+module type Monad = sig
+  type 'a t
+
+  val ( >>= ) : 'a t @ p-> ('a -> 'b t) @ p -> 'b t @ p
+  (** [p >>= f] creates a parser that will run [p], pass its result to [f], run
+      the parser that [f] produces, and return its result. *)
+
+  val ( >>| ) : 'a t @ p -> ('a -> 'b) @ p -> 'b t @ p
+  (** [p >>| f] creates a parser that will run [p], and if it succeeds with
+      result [v], will return [f v] *)
+
+  val ( <*> ) : ('a -> 'b) t @ p -> 'a t @ p -> 'b t @ p
+  (** [f <*> p] is equivalent to [f >>= fun f -> p >>| f]. *)
+
+  val ( <$> ) : ('a -> 'b) @ p -> 'a t @ p -> 'b t @ p
+  (** [f <$> p] is equivalent to [p >>| f] *)
+
+  val ( *> ) : 'b t @ p -> 'a t @ p -> 'a t @ p
+  (** [p *> q] runs [p], discards its result and then runs [q], and returns
+      its result. *)
+
+  val ( <* ) : 'a t @ p -> 'b t @ p -> 'a t @ p
+  (** [p <* q] runs [p], then runs [q], discards its result, and returns the
+      result of [p]. *)
+end
+
+
+module type S = sig
+  type 'a t
+  include Choice [@mode p] with type 'a t := 'a t
+  include Monad [@mode p] with type 'a t := 'a t
+end
+]
+
+module type%template Operators = sig @@ portable
+  [@@@mode.default p = (nonportable, portable)]
+
+  module type Choice = Choice [@mode p]
+  module type Monad = Monad [@mode p]
+  module type S = S [@mode p]
+end
